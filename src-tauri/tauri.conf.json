{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Locked In Planner",
  "version": "0.1.6",
  "identifier": "app.lockedinplanner.desktop",
  "build": {
    "frontendDist": "http://localhost:3000",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Locked In Planner",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "url": "about:blank",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/app": "app",
      "resources/node/node.exe": "node/node.exe",
      "resources/template.db": "template.db",
      "resources/migrations": "migrations"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
